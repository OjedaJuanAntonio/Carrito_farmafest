# Cabeceras para Cloudflare Pages (Next las copia de public/ a out/).
# Equivalente al viejo vercel.json.

# Datos: siempre revalidar (los precios cambian durante el evento).
/data/*
  Cache-Control: public, max-age=0, must-revalidate

# Service worker: nunca cachear (controla las actualizaciones de la app).
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Manifest: revalidar.
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# Assets con hash de Next: cache inmutable de larga duración.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
